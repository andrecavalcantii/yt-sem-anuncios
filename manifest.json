{
  "manifest_version": 3,
  "name": "YT Sem Anúncios",
  "version": "0.2.0",
  "description": "Remove anúncios do YouTube (limpa os dados do player, bloqueia requisições de anúncio e pula o que escapar) e esconde os Shorts.",
  "permissions": ["declarativeNetRequest", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "YT Sem Anúncios",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "host_permissions": ["*://*.youtube.com/*", "*://*.doubleclick.net/*", "*://*.googleadservices.com/*", "*://*.googlesyndication.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "anuncios", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "yt-sem-anuncios@local", "strict_min_version": "128.0" }
  }
}
